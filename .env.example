cat << 'EOF' > .env.example
# ==========================================
# PLANTILLA PÚBLICA DE CONFIGURACIÓN (.env.example)
# ==========================================

# BASE DE DATOS LOCAL
# Generar password y user accesible para profesores, personal autorizado y administrativo.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=<database_name>
DB_USER=postgres
DB_PASSWORD=

# SEGURIDAD Y TOKENS (JWT)
# Generar secreto seguro con: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# SERVICIOS EXTERNOS (APIs)
PAYMENT_GATEWAY_KEY=
EMAIL_SERVICE_API_KEY=
EOF